# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Channel ID
CHANNEL_ID=your_discord_channel_id_here

# Captcha Service APIs (add any combination of these)
# CapSolver - https://www.capsolver.com
CAPSOLVER_API_KEY=

# 2Captcha - https://2captcha.com
2CAPTCHA_API_KEY=

# NopeCHA - https://nopecha.com
NOPECHA_API_KEY=

# AntiCaptcha - https://anti-captcha.com
ANTICAPTCHA_API_KEY=

# DeathByCaptcha - https://www.deathbycaptcha.com
DEATHBYCAPTCHA_USER=
DEATHBYCAPTCHA_PASS=

# Optional: Set service priority (comma-separated)
# Default: capsolver,2captcha,nopecha,anticaptcha,deathbycaptcha
CAPTCHA_SERVICE_PRIORITY=
